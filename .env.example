RESY_EMAIL=you@example.com
RESY_PASSWORD=changeme
# Optional — only set if Resy rotates the public web-app key.
# RESY_API_KEY=VbWk7s3L4KiK5fzlO7JD3Q5EYolJI7n5

# Optional: the token is cached between runs so a restart does not
# re-authenticate. Set to false to turn that off.
# RESY_TOKEN_CACHE=false
# Optional: where that cache lives. Defaults to $MCP_DATA_DIR/.resy-mcp/token.json.
# RESY_TOKEN_FILE=/path/to/cache.json
# Optional: the fetchproxy bridge port. The whole fleet shares 37149 (the
# Transporter extension dials it) — override only for local development or
# test isolation.
# RESY_WS_PORT=37149
